{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C/C++: 调试当前文件 (在集成终端中运行，完美支持中文)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [
                {
                    "name": "LANG",
                    "value": "zh_CN.UTF-8"
                }
            ],
            "externalConsole": false,
            "console": "integratedTerminal",
            "MIMode": "lldb",
            "preLaunchTask": "C/C++: clang 生成活动文件"
        },
        {
            "name": "C/C++: 输出到 bin 目录调试",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "console": "integratedTerminal",
            "MIMode": "lldb",
            "preLaunchTask": "C/C++: 编译当前活动文件"
        }
    ]
}
